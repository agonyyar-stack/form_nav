<launch>
    <arg name="uav_id" default="uav0" />
    <arg name="my_id" default="0" />
    <arg name="world_frame" default="world" />
    <arg name="formation_config_file" default="$(find form_nav)/config/formations.yaml" />
    <arg name="formation_config_namespace" default="/formation_config" />
    <arg name="load_formation_config" default="true" />
    <arg name="neighbor_trajectory_timeout" default="0.3" />
    <arg name="neighbor_future_tolerance" default="0.05" />
    <arg name="progress_timeout" default="0.3" />
    <arg name="tracking_model" default="1" />

    <!-- A multi-UAV parent launch can load this once and pass load_formation_config=false. -->
    <group if="$(arg load_formation_config)">
        <rosparam command="load" file="$(arg formation_config_file)"
                  ns="$(arg formation_config_namespace)" />
    </group>
    <!-- 启动DWA仿真节点 -->
    <node pkg="form_nav" name="$(arg uav_id)_mpc_node"  type="mpc_node" output="screen">
        <param name="sdf_map/resolution" value="0.1" />
        <param name="sdf_map/map_size_x" value="40.0" />
        <param name="sdf_map/map_size_y" value="20.0" />
        <param name="sdf_map/map_size_z" value="3.0" />
        <param name="sdf_map/local_update_range_x" value="5.0" />
        <param name="sdf_map/local_update_range_y" value="5.0" />
        <param name="sdf_map/local_update_range_z" value="3.0" />
        <param name="sdf_map/obstacles_inflation" value="0.3" />
        <param name="sdf_map/local_map_margin" value="30" />
        <param name="sdf_map/ground_height" value="-0.01" />

        <!-- local fusion -->
        <param name="sdf_map/virtual_ceil_height" value="2.5" />
        <param name="sdf_map/visualization_truncate_height" value="2.4" />
        <param name="sdf_map/show_occ_time" value="false" />
        <param name="sdf_map/pose_type" value="2" />
        <param name="sdf_map/frame_id" value="map" />

        <param name="my_id" value="$(arg my_id)" />
        <param name="world_frame" value="$(arg world_frame)" />
        <param name="local_frame" value="$(arg uav_id)/map" />
        <param name="formation_config_namespace" value="$(arg formation_config_namespace)" />
        <param name="tracking_model" value="$(arg tracking_model)" />

        <!-- MPC 可调参数 -->
        <param name="mpc/N" value="10" />               <!-- 预测步长 -->
        <param name="mpc/dt" value="0.05" />             <!-- 时间步长 (s) -->
        <param name="mpc/u_max" value="2.0" />           <!-- 线速度/加速度上限 -->
        <param name="mpc/w_max" value="2.0" />           <!-- 角速度/加速度上限 -->
        <param name="mpc/d_safe_oa" value="0.6" />       <!-- 障碍物安全距离 (m) -->
        <param name="mpc/d_critical_oa" value="0.3" />   <!-- 障碍物临界距离 (m) -->
        <param name="mpc/d_safe_ca" value="0.3" />       <!-- 编队内安全距离 (m) -->
        <param name="mpc/w_vel" value="150.0" />            <!-- 中间步速度跟踪权重（过大易沿程振荡） -->
        <param name="mpc/w_terminal_vel" value="2000.0" />   <!-- 终端速度惩罚权重（终点刹车） -->
        <param name="mpc/w_du" value="100.0" />             <!-- 控制增量惩罚（抑制指令抖动） -->
        <param name="mpc/terminal_pos_scale" value="0.2" />  <!-- 终端位置权重缩放（减小终点冲刺） -->
        <param name="mpc/docking_distance" value="1.5" />    <!-- 末端减速缓冲区 (m) -->
        <param name="communication/neighbor_trajectory_timeout"
               value="$(arg neighbor_trajectory_timeout)" />
        <param name="communication/neighbor_future_tolerance"
               value="$(arg neighbor_future_tolerance)" />
        <param name="global_progress/timeout" value="$(arg progress_timeout)" />
        <remap from="/sdf_map/cloud" to="/map_generator/global_cloud"/> 
        <remap from="/sdf_map/occupancy_inflate" to="/$(arg uav_id)/sdf_map/occupancy_inflate"/>
        <remap from="/sdf_map/odom" to="/$(arg uav_id)/mavros/local_position/odom"/>
    </node>

</launch>
