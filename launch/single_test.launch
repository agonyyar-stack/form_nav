<launch>
    <!-- 1=fixed（固定复杂场景）, 2=random（随机障碍物） -->
    <arg name="scene" default="1" />
    <!-- 全局层算法选择: kino_astar=kinodynamic A*, astar=纯 A* -->
    <arg name="global_planner" default="1" /> <!-- 1=astar（纯 A*）, 2=kino_astar（kinodynamic A*） -->

    <!-- gazebo -->
    <include file="$(find form_nav)/launch/single_uav_gazebo.launch">
    </include>

    <group unless="$(eval arg('scene') == 1)">
        <!-- 静态障碍物地图生成 -->
        <!-- pkg：指定哪个 ROS 包，type：包里要运行的可执行文件名，name：该节点启动后在 ROS 系统里注册的名字 -->
        <!-- CMake 中的可执行文件名为 random_obs。保留节点名 random_static_obs，
             仅修正 type，避免 launch 找不到可执行文件。 -->
        <node pkg="form_nav" type="random_obs" name="random_obs" output="screen" >
            <param name="pattern" value="1" /> <!-- 1=静态(默认), 2=动态, 3=静+动 -->

            <param name="map/x_size"     value="40.0" /> <!-- 地图的x轴大小 -->
            <param name="map/y_size"     value="40.0" /> <!-- 地图的y轴大小 -->
            <param name="map/z_size"     value="3" /> <!-- 地图的z轴大小 -->
            <param name="map/resolution" value="0.1"/> <!-- 地图的分辨率为空间分辨率 -->

            <param name="map/obs_num"             value="60"/> <!-- 障碍物的数量 -->
            <param name="ObstacleShape/lower_rad" value="0.5"/> <!-- 障碍物的最小半径 -->
            <param name="ObstacleShape/upper_rad" value="1.0"/> <!-- 障碍物的最大半径 -->
            <param name="ObstacleShape/lower_hei" value="0.0"/> <!-- 障碍物的最小高度 -->
            <param name="ObstacleShape/upper_hei" value="3.0"/> <!-- 障碍物的最大高度 -->

            <param name="map/circle_num"         value="60"/> <!-- 圆形障碍物的数量 -->
            <param name="ObstacleShape/radius_l" value="0.7"/> <!-- 圆形障碍物的最小半径 -->
            <param name="ObstacleShape/radius_h" value="0.5"/> <!-- 圆形障碍物的最大半径 -->
            <param name="ObstacleShape/z_l"      value="0.7"/> <!-- 圆形障碍物的最小高度 -->
            <param name="ObstacleShape/z_h"      value="0.8"/> <!-- 圆形障碍物的最大高度 -->
            <param name="ObstacleShape/theta"    value="0.5"/> <!-- 圆形障碍物的旋转角度 -->

            <param name="min_distance" value="1.2"/> <!-- 障碍物最小间距 -->

            <param name="dyn_obs/num"      value="20" />
            <param name="dyn_obs/size"     value="0.3" />  <!-- 障碍物半径 -->
            <param name="dyn_obs/height"   value="2.0" />  <!-- 圆柱高度 -->
            <param name="dyn_obs/traj_dt"  value="0.05" /> <!-- 障碍物轨迹采样步长 (s)，对齐 MPC -->
            <param name="dyn_obs/traj_steps" value="21" /> <!-- 障碍物轨迹步数 (N+1)，N=20 -->
            <param name="dyn_obs/speed_l"  value="0.5" /> <!-- 速度范围 -->
            <param name="dyn_obs/speed_h"  value="1.0" />
            <param name="dyn_obs/period_l" value="3.0" /> <!-- 周期范围 -->
            <param name="dyn_obs/period_h" value="8.0" />
            <param name="dyn_obs/radius_l" value="1.5" />  <!-- 轨迹半径范围 -->
            <param name="dyn_obs/radius_h" value="5.0" />
        </node>
    </group>

    <group if="$(eval arg('scene') == 1)">
        <include file="$(find form_nav)/launch/obs_generator.launch">
            <arg name="dyn_obs_num" value="-1" /> <!-- -1=全部, 0=关闭, n>0=只取前 n 个 -->
            <arg name="rviz" value="false" />
        </include>
    </group>

    <!-- rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find form_nav)/rviz/single_test.rviz" />

    <!-- 切换模式，解锁 -->
    <include file="$(find form_nav)/launch/uav_base.launch" >
        <param name="uav_id" value="uav0" />
    </include>

    <!-- 里程计可视化（无人机模型 Marker） -->
    <include file="$(find form_nav)/launch/odom_visualization.launch">
        <arg name="uav_id" value="uav0" />
        <arg name="color_r" value="1.0" />
        <arg name="color_g" value="0.2" />
        <arg name="color_b" value="0.2" />
    </include>

    <!-- 全局规划器（kinoA*） -->
    <group if="$(eval arg('global_planner') == 2)">
    <include file="$(find form_nav)/launch/kino_astar_grid.launch">
        <arg name="uav_id" value="uav0" />
        <arg name="my_id" value="0" />
        <arg name="formation_config_file" value="$(find form_nav)/config/single_uav.yaml" />
    </include>
    </group>

    <!-- 全局规划器（纯 A*） -->
    <group if="$(eval arg('global_planner') == 1)">
    <include file="$(find form_nav)/launch/astar_grid.launch">
        <arg name="uav_id" value="uav0" />
        <arg name="my_id" value="0" />
        <arg name="formation_config_file" value="$(find form_nav)/config/single_uav.yaml" />
    </include>
    </group>

    <!-- 局部 MPC -->
    <include file="$(find form_nav)/launch/mpc.launch">
        <arg name="uav_id" value="uav0" />
        <arg name="my_id" value="0" />
        <arg name="formation_config_file" value="$(find form_nav)/config/single_uav.yaml" />
    </include>

</launch>
