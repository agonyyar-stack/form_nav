<?xml version="1.0"?>
<launch>
  <arg name="rviz" default="true" />
  <arg name="world_frame" default="world" />
  <arg name="formation_config_file"
       default="$(find form_nav)/config/formations.yaml" />
  <arg name="formation_config_namespace" default="/formation_config" />
  <arg name="neighbor_trajectory_timeout" default="0.3" />
  <arg name="neighbor_future_tolerance" default="0.05" />
  <arg name="progress_timeout" default="0.3" />

  <include file="$(find form_nav)/launch/multi_uav_gazebo.launch">
  </include>

  <node pkg="form_nav" type="random_obs" name="random_obs" output="screen" >
    <param name="pattern" value="1" /> <!-- 1=静态(默认), 2=动态, 3=静+动 -->

    <param name="map/x_size"     value="40.0" /> <!-- 地图的x轴大小 -->
    <param name="map/y_size"     value="40.0" /> <!-- 地图的y轴大小 -->
    <param name="map/z_size"     value="3" /> <!-- 地图的z轴大小 -->
    <param name="map/resolution" value="0.1"/> <!-- 地图的分辨率为空间分辨率 -->

    <param name="map/obs_num"             value="60"/> <!-- 障碍物的数量 -->
    <param name="ObstacleShape/lower_rad" value="0.5"/> <!-- 障碍物的最小半径 -->
    <param name="ObstacleShape/upper_rad" value="1.0"/> <!-- 障碍物的最大半径 -->
    <param name="ObstacleShape/lower_hei" value="0.0"/> <!-- 障碍物的最小高度 -->
    <param name="ObstacleShape/upper_hei" value="3.0"/> <!-- 障碍物的最大高度 -->

    <param name="map/circle_num"         value="60"/> <!-- 圆形障碍物的数量 -->
    <param name="ObstacleShape/radius_l" value="0.7"/> <!-- 圆形障碍物的最小半径 -->
    <param name="ObstacleShape/radius_h" value="0.5"/> <!-- 圆形障碍物的最大半径 -->
    <param name="ObstacleShape/z_l"      value="0.7"/> <!-- 圆形障碍物的最小高度 -->
    <param name="ObstacleShape/z_h"      value="0.8"/> <!-- 圆形障碍物的最大高度 -->
    <param name="ObstacleShape/theta"    value="0.5"/> <!-- 圆形障碍物的旋转角度 -->

    <param name="min_distance" value="1.2"/> <!-- 障碍物最小间距 -->

    <param name="dyn_obs/num"      value="20" />
    <param name="dyn_obs/size"     value="0.8" />  <!-- 底面边长 -->
    <param name="dyn_obs/height"   value="2.0" />  <!-- 高度 -->
    <param name="dyn_obs/speed_l"  value="0.5" /> <!-- 速度范围 -->
    <param name="dyn_obs/speed_h"  value="2.0" />
    <param name="dyn_obs/period_l" value="3.0" /> <!-- 周期范围 -->
    <param name="dyn_obs/period_h" value="8.0" />
    <param name="dyn_obs/radius_l" value="1.5" />  <!-- 轨迹半径范围 -->
    <param name="dyn_obs/radius_h" value="5.0" />
  </node>

  <rosparam command="load" file="$(arg formation_config_file)"
            ns="$(arg formation_config_namespace)" />

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find form_nav)/rviz/formation_planning.rviz" />
  </group>

  <include file="$(find form_nav)/launch/uav_base.launch">
    <arg name="uav_id" value="uav0" />
  </include>
  <include file="$(find form_nav)/launch/uav_base.launch">
    <arg name="uav_id" value="uav1" />
  </include>
  <include file="$(find form_nav)/launch/uav_base.launch">
    <arg name="uav_id" value="uav2" />
  </include>
  <include file="$(find form_nav)/launch/uav_base.launch">
    <arg name="uav_id" value="uav3" />
  </include>
  <include file="$(find form_nav)/launch/uav_base.launch">
    <arg name="uav_id" value="uav4" />
  </include>
  <include file="$(find form_nav)/launch/uav_base.launch">
    <arg name="uav_id" value="uav5" />
  </include>

  <include file="$(find form_nav)/launch/kino_astar_grid.launch">
    <arg name="uav_id" value="uav4" />
    <arg name="formation_offset_x" value="1.0" />
    <arg name="formation_offset_y" value="0.0" />
    <arg name="formation_offset_z" value="0.0" />
    <arg name="world_frame" value="$(arg world_frame)" />
  </include>

  <include file="$(find form_nav)/launch/mpc_esdf.launch">
    <arg name="uav_id" value="uav0" />
    <arg name="my_id" value="0" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="formation_config_file" value="$(arg formation_config_file)" />
    <arg name="formation_config_namespace" value="$(arg formation_config_namespace)" />
    <arg name="load_formation_config" value="false" />
    <arg name="neighbor_trajectory_timeout" value="$(arg neighbor_trajectory_timeout)" />
    <arg name="neighbor_future_tolerance" value="$(arg neighbor_future_tolerance)" />
    <arg name="progress_timeout" value="$(arg progress_timeout)" />
  </include>
  <include file="$(find form_nav)/launch/mpc_esdf.launch">
    <arg name="uav_id" value="uav1" />
    <arg name="my_id" value="1" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="formation_config_file" value="$(arg formation_config_file)" />
    <arg name="formation_config_namespace" value="$(arg formation_config_namespace)" />
    <arg name="load_formation_config" value="false" />
    <arg name="neighbor_trajectory_timeout" value="$(arg neighbor_trajectory_timeout)" />
    <arg name="neighbor_future_tolerance" value="$(arg neighbor_future_tolerance)" />
    <arg name="progress_timeout" value="$(arg progress_timeout)" />
  </include>
  <include file="$(find form_nav)/launch/mpc_esdf.launch">
    <arg name="uav_id" value="uav2" />
    <arg name="my_id" value="2" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="formation_config_file" value="$(arg formation_config_file)" />
    <arg name="formation_config_namespace" value="$(arg formation_config_namespace)" />
    <arg name="load_formation_config" value="false" />
    <arg name="neighbor_trajectory_timeout" value="$(arg neighbor_trajectory_timeout)" />
    <arg name="neighbor_future_tolerance" value="$(arg neighbor_future_tolerance)" />
    <arg name="progress_timeout" value="$(arg progress_timeout)" />
  </include>
  <include file="$(find form_nav)/launch/mpc_esdf.launch">
    <arg name="uav_id" value="uav3" />
    <arg name="my_id" value="3" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="formation_config_file" value="$(arg formation_config_file)" />
    <arg name="formation_config_namespace" value="$(arg formation_config_namespace)" />
    <arg name="load_formation_config" value="false" />
    <arg name="neighbor_trajectory_timeout" value="$(arg neighbor_trajectory_timeout)" />
    <arg name="neighbor_future_tolerance" value="$(arg neighbor_future_tolerance)" />
    <arg name="progress_timeout" value="$(arg progress_timeout)" />
  </include>
  <include file="$(find form_nav)/launch/mpc_esdf.launch">
    <arg name="uav_id" value="uav4" />
    <arg name="my_id" value="4" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="formation_config_file" value="$(arg formation_config_file)" />
    <arg name="formation_config_namespace" value="$(arg formation_config_namespace)" />
    <arg name="load_formation_config" value="false" />
    <arg name="neighbor_trajectory_timeout" value="$(arg neighbor_trajectory_timeout)" />
    <arg name="neighbor_future_tolerance" value="$(arg neighbor_future_tolerance)" />
    <arg name="progress_timeout" value="$(arg progress_timeout)" />
  </include>
  <include file="$(find form_nav)/launch/mpc_esdf.launch">
    <arg name="uav_id" value="uav5" />
    <arg name="my_id" value="5" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="formation_config_file" value="$(arg formation_config_file)" />
    <arg name="formation_config_namespace" value="$(arg formation_config_namespace)" />
    <arg name="load_formation_config" value="false" />
    <arg name="neighbor_trajectory_timeout" value="$(arg neighbor_trajectory_timeout)" />
    <arg name="neighbor_future_tolerance" value="$(arg neighbor_future_tolerance)" />
    <arg name="progress_timeout" value="$(arg progress_timeout)" />
  </include>
</launch>
