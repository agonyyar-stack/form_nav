<launch>
    <arg name="uav_id" default="uav0" />
    <arg name="my_id" default="0" />
    <arg name="world_frame" default="world" />
    <arg name="formation_config_file" default="$(find form_nav)/config/formations.yaml" />
    <arg name="formation_config_namespace" default="/formation_config" />
    <arg name="load_formation_config" default="true" />
    <arg name="neighbor_trajectory_timeout" default="0.3" />
    <arg name="neighbor_future_tolerance" default="0.05" />
    <!-- A multi-UAV parent launch can load this once and pass load_formation_config=false. -->
    <group if="$(arg load_formation_config)">
        <rosparam command="load" file="$(arg formation_config_file)"
                  ns="$(arg formation_config_namespace)" />
    </group>
    <!-- 启动DWA仿真节点 -->
    <node pkg="form_nav" name="$(arg uav_id)_mpc_node"  type="mpc_node" output="screen">
        <param name="my_id" value="$(arg my_id)" />
        <param name="world_frame" value="$(arg world_frame)" />
        <param name="local_frame" value="$(arg uav_id)/map" />
        <param name="formation_config_namespace" value="$(arg formation_config_namespace)" />
        <!-- MPC 可调参数 -->
        <param name="mpc/N" value="20" />               <!-- 预测步长 -->
        <param name="mpc/dt" value="0.05" />             <!-- 时间步长 (s) -->
        <param name="mpc/u_max" value="2.0" />           <!-- 线速度指令上限 (m/s) -->
        <param name="mpc/w_max" value="2.0" />           <!-- 偏航角速度指令上限 (rad/s) -->

        <param name="mpc/w_ca" value="20.0" />          <!-- 相互碰撞惩罚权重 -->
        <param name="mpc/w_form" value="0.0" />        <!-- 编队误差权重-->
        <param name="mpc/d_safe_ca" value="0.2" />     <!-- 编队内硬安全距离 (m)，，扣除无人机半径 -->
        <param name="mpc/d_act_ca" value="1.0" />      <!-- 编队避碰激活范围 D̄ (m)，扣除无人机半径，须大于 d_safe_ca 且小于编队间距 -->

        <param name="mpc/w_subgoal" value="1000.0" />   <!-- 滚动子目标惩罚权重 -->
        <param name="mpc/w_yaw" value="100.0" />        <!-- yaw 参考（子目标方向）软约束权重，复用终端 Q_ -->
        <param name="mpc/lookahead_distance" value="2.0" /> <!-- 滚动子目标前瞻距离 (m) -->
        <param name="mpc/yaw_lock_dist" value="0.3" />   <!-- 进入终点范围后冻结 yaw 参考的距离 (m) -->

        <param name="mpc/w_oa" value="10.0" />             <!-- 静态避障权重 -->
        <param name="mpc/w_dyn" value="20.0" />            <!-- 动态避障权重 -->
        <param name="mpc/d_safe_dyn" value="0.2" />         <!-- 动态障碍物最小安全距离 (m，表面口径) -->
        <param name="mpc/d_act_dyn" value="1.5" />          <!-- 动态障碍物激活范围 (m)，须大于 d_safe_dyn -->
        <param name="mpc/nearest_obs_num" value="3" />    <!-- 每步查询最近障碍点数量 -->
        <param name="mpc/drone_radius" value="0.3" />     <!-- 无人机半径 (m) -->
        <param name="mpc/safe_dist" value="0.05" />        <!-- 最小安全距离 L (m)，扣除无人机半径 -->
        <param name="mpc/detect_range" value="1.05" />     <!-- 障碍物探测范围 D̄ (m)，扣除无人机半径，须大于 safe_dist -->
        <param name="mpc/replan_max_iter" value="1" />    <!-- 最近点重查询重规划次数（查询点固定为参考，默认 0） -->
        <param name="mpc/hold_dist" value="0.35" />       <!-- 近距紧急悬停阈值 (m),考虑无人机半径，硬安全兜底 -->

        <param name="mpc/kd_tree_voxel_size" value="0.1" /> <!-- 建树前体素降采样 (m) -->
        <param name="mpc/kd_tree_update_interval" value="2.0" /> <!-- 建树最小间隔 (s) -->

        <param name="mpc/ipopt_max_iter" value="100" />   <!-- IPOPT 最大迭代次数 -->
        <param name="mpc/ipopt_tol" value="1e-6" />       <!-- IPOPT 收敛容差 -->

        <param name="mpc/w_u" value="1.0" />              <!-- 控制输入惩罚 -->
        <param name="mpc/w_du" value="100.0" />             <!-- 控制增量惩罚（抑制指令抖动） -->

        <param name="mpc/tau_v" value="0.67" />            <!-- 线速度一阶时间常数 (s) -->
        <param name="mpc/tau_w" value="0.5" />            <!-- 偏航角速度一阶时间常数 (s) -->
        <param name="mpc/arrival_distance" value="0.1" />   <!-- 到达锁定：到终点直线距离阈值 (m) -->
        <param name="mpc/arrival_velocity" value="0.1" />   <!-- 到达锁定：3D 速度阈值 (m/s) -->

        <param name="communication/neighbor_trajectory_timeout"
               value="$(arg neighbor_trajectory_timeout)" />
        <param name="communication/neighbor_future_tolerance"
               value="$(arg neighbor_future_tolerance)" />
        <param name="cloud_topic" value="/map_generator/global_cloud" />
    </node>

</launch>
